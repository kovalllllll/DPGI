<Window x:Class="Lab4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товари — Варіант 8" Height="500" Width="540"
        Loaded="Window_Loaded">

    <DockPanel>
        <!-- Завдання 4: Панель інструментів -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Name="BtnCreate" Click="BtnCreate_Click">Create</Button>
                <Separator/>
                <Button Name="BtnUpdate" Click="BtnUpdate_Click">Update</Button>
                <Separator/>
                <Button Name="BtnDelete" Click="BtnDelete_Click">Delete</Button>
            </ToolBar>
        </ToolBarTray>

        <!-- Завдання 3: Основний Grid з прив'язкою до вибраного елементу -->
        <Grid DataContext="{Binding ElementName=ListNazva, Path=SelectedItem}"
              Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Список товарів -->
            <ListBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                     Margin="0,0,0,6"
                     Name="ListNazva"
                     ItemsSource="{Binding}"
                     DisplayMemberPath="Назва"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>

            <!-- Поля деталей -->
            <TextBlock Grid.Row="1" Grid.Column="0" Margin="4">Артикул:</TextBlock>
            <TextBox   Grid.Row="1" Grid.Column="1" Name="TxtArtikul"
                       Text="{Binding Path=Артикул, Mode=OneWay}"
                       IsReadOnly="True" Margin="0,2,0,2"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Margin="4">Назва:</TextBlock>
            <TextBox   Grid.Row="2" Grid.Column="1" Name="TxtNazva"
                       Text="{Binding Path=Назва, Mode=OneWay}"
                       Margin="0,2,0,2"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Margin="4">Одиниця виміру:</TextBlock>
            <TextBox   Grid.Row="3" Grid.Column="1" Name="TxtOdVymiru"
                       Text="{Binding Path=ОдВиміру, Mode=OneWay}"
                       Margin="0,2,0,2"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Margin="4">Кількість:</TextBlock>
            <TextBox   Grid.Row="4" Grid.Column="1" Name="TxtKilkist"
                       Text="{Binding Path=Кількість, Mode=OneWay}"
                       Margin="0,2,0,2"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Margin="4">Ціна:</TextBlock>
            <TextBox   Grid.Row="5" Grid.Column="1" Name="TxtTsina"
                       Text="{Binding Path=Ціна, Mode=OneWay}"
                       Margin="0,2,0,2"/>
        </Grid>
    </DockPanel>
</Window>