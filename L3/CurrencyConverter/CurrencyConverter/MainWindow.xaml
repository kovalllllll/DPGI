<Window x:Class="CurrencyConverter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:currencyConverter="clr-namespace:CurrencyConverter"
        Title="Конвертер валют · UAH"
        MinWidth="880" MinHeight="580"
        Width="1100" Height="750"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrBgDeep}">

    <Window.DataContext>
        <currencyConverter:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ════════ HEADER ════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource BrBgCard}"
                BorderBrush="{StaticResource BrBorder}"
                BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="₴" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource BrAccent}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="КОНВЕРТЕР ВАЛЮТ"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource BrTextPrimary}" />
                        <TextBlock Text="Довідник курсів НБУ · SQLite DB"
                                   FontSize="11"
                                   Foreground="{StaticResource BrTextSecond}" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="2" VerticalAlignment="Center"
                        Background="#1F3A2C" CornerRadius="20" Padding="12,5">
                    <TextBlock FontSize="12" Foreground="{StaticResource BrAccent}" FontWeight="SemiBold">
                        <Run Text="🟢 " />
                        <Run Text="Базова валюта: UAH" />
                    </TextBlock>
                </Border>
            </Grid>
        </Border>

        <!-- ════════ BODY ════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="3*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <!-- ── LEFT PANEL: catalogue ── -->
            <Border Grid.Column="0"
                    Background="{StaticResource BrBgCard}"
                    BorderBrush="{StaticResource BrBorder}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="16,12"
                            BorderBrush="{StaticResource BrBorder}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="ДОВІДНИК ВАЛЮТ"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource BrTextSecond}" />
                                <TextBlock FontSize="12" Foreground="{StaticResource BrTextMuted}">
                                    <Run Text="{Binding Currencies.Count, Mode=OneWay}" />
                                    <Run Text=" валюти у базі" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource BtnGreen}"
                                        Content="＋ Додати"
                                        FontSize="12" Padding="10,7"
                                        Command="{Binding AddCurrencyCommand}"
                                        ToolTip="Додати нову валюту" />
                                <Button Style="{StaticResource BtnDanger}"
                                        Content="✕"
                                        FontSize="13" Padding="9,7" Width="32"
                                        Margin="6,0,0,0"
                                        Command="{Binding RemoveCurrencyCommand}"
                                        ToolTip="Видалити обрану валюту" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Currencies}"
                              SelectedItem="{Binding SelectedCurrency}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header=""
                                                Binding="{Binding Flag}"
                                                Width="50" FontSize="18" />
                            <DataGridTextColumn Header="КОД"
                                                Binding="{Binding Code}"
                                                Width="58" FontWeight="Bold"
                                                FontFamily="Cascadia Code, Consolas" />
                            <DataGridTextColumn Header="НАЗВА"
                                                Binding="{Binding Name}"
                                                Width="*" />
                            <DataGridTextColumn Header="ОД."
                                                Binding="{Binding Units}"
                                                Width="60"
                                                ElementStyle="{StaticResource LabelValue}" />
                            <DataGridTemplateColumn Header="КУРС (ГРН)" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center"
                                                   Foreground="{StaticResource BrAccent}"
                                                   FontFamily="Cascadia Code, Consolas"
                                                   FontWeight="SemiBold" FontSize="13">
                                            <Run Text="{Binding Rate, StringFormat='N2', Mode=OneWay}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Padding="14,8"
                            BorderBrush="{StaticResource BrBorder}"
                            BorderThickness="0,1,0,0">
                        <TextBlock FontSize="11" Foreground="{StaticResource BrTextMuted}"
                                   TextWrapping="Wrap">
                            ⓘ Курси орієнтовані на офіційні дані НБУ. Дані зберігаються в SQLite.
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>

            <!-- ── SPLITTER ── -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="{StaticResource BrBorder}"
                          ShowsPreview="True" />

            <!-- ── RIGHT PANEL ── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />      <!-- конвертер + редагування -->
                    <RowDefinition Height="Auto" />   <!-- заголовок журналу -->
                    <RowDefinition Height="200" />    <!-- DataGrid журналу -->
                    <RowDefinition Height="Auto" />   <!-- кнопка очистити -->
                </Grid.RowDefinitions>

                <!-- Конвертер + редагування -->
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,20,24,0" MaxWidth="520">

                        <!-- ─── CONVERTER CARD ─── -->
                        <Border Background="{StaticResource BrBgCard}"
                                BorderBrush="{StaticResource BrBorder}"
                                BorderThickness="1" CornerRadius="10" Padding="20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="⇄" FontSize="18"
                                               Foreground="{StaticResource BrAccent}"
                                               Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Конвертація" FontSize="16" FontWeight="Bold"
                                               Foreground="{StaticResource BrTextPrimary}"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Selected currency badge -->
                                <Border Background="{StaticResource BrBgPanel}"
                                        CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding SelectedCurrency.Flag}"
                                                   FontSize="22" VerticalAlignment="Center"
                                                   Margin="0,0,10,0" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock FontSize="15" FontWeight="Bold"
                                                       Foreground="{StaticResource BrTextPrimary}">
                                                <Run Text="{Binding SelectedCurrency.Code, Mode=OneWay}" />
                                                <Run Text=" — " />
                                                <Run Text="{Binding SelectedCurrency.Name, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock FontSize="12"
                                                       Foreground="{StaticResource BrTextSecond}">
                                                <Run Text="1 " />
                                                <Run Text="{Binding SelectedCurrency.Code, Mode=OneWay}" />
                                                <Run Text=" = " />
                                                <Run Text="{Binding SelectedCurrency.RatePerUnit, StringFormat='N4', Mode=OneWay}"
                                                     Foreground="{StaticResource BrAccent}"
                                                     FontFamily="Cascadia Code, Consolas" />
                                                <Run Text=" грн" />
                                            </TextBlock>
                                        </StackPanel>
                                        <Border Grid.Column="2"
                                                Background="#1F3A2C" CornerRadius="6"
                                                Padding="8,4" VerticalAlignment="Center">
                                            <TextBlock FontSize="11" FontWeight="Bold"
                                                       Foreground="{StaticResource BrAccent}"
                                                       FontFamily="Cascadia Code, Consolas">
                                                <Run Text="{Binding SelectedCurrency.Rate, StringFormat='N2', Mode=OneWay}" />
                                                <Run Text=" / " />
                                                <Run Text="{Binding SelectedCurrency.Units, Mode=OneWay}" />
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- FROM -->
                                <TextBlock Style="{StaticResource LabelCaption}">
                                    <Run Text="{Binding SelectedCurrency.Code, Mode=OneWay}" />
                                    <Run Text=" — Сума у валюті" />
                                </TextBlock>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding ForeignAmountText, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="22" FontWeight="SemiBold"
                                             Padding="14,12" />
                                    <Border Grid.Column="1" Margin="8,0,0,0"
                                            Background="{StaticResource BrBgPanel}"
                                            BorderBrush="{StaticResource BrBorder}"
                                            BorderThickness="1" CornerRadius="6"
                                            Padding="12,0" MinWidth="60">
                                        <TextBlock Text="{Binding SelectedCurrency.Code}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   FontSize="16" FontWeight="Bold"
                                                   FontFamily="Cascadia Code, Consolas"
                                                   Foreground="{StaticResource BrAccent}" />
                                    </Border>
                                </Grid>

                                <!-- Swap -->
                                <Button Style="{StaticResource BtnGhost}"
                                        Command="{Binding SwapCommand}"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,12"
                                        Padding="20,8" FontSize="16"
                                        ToolTip="Поміняти суми місцями">
                                    <TextBlock>
                                        <Run Text="⇅  " />
                                        <Run Text="Поміняти" FontSize="12" />
                                    </TextBlock>
                                </Button>

                                <!-- TO: UAH -->
                                <TextBlock Style="{StaticResource LabelCaption}"
                                           Text="UAH — Сума у гривнях" />
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding UahAmountText, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="22" FontWeight="SemiBold"
                                             Padding="14,12" />
                                    <Border Grid.Column="1" Margin="8,0,0,0"
                                            Background="#1F3A2C"
                                            BorderBrush="{StaticResource BrAccent}"
                                            BorderThickness="1" CornerRadius="6"
                                            Padding="12,0" MinWidth="60">
                                        <TextBlock Text="₴"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   FontSize="22" FontWeight="Bold"
                                                   Foreground="{StaticResource BrAccent}" />
                                    </Border>
                                </Grid>

                                <Button Style="{StaticResource BtnGhost}"
                                        Content="🗑  Очистити"
                                        Command="{Binding ClearCommand}"
                                        HorizontalAlignment="Right"
                                        FontSize="12" Padding="12,7" />
                            </StackPanel>
                        </Border>

                        <!-- ─── EDIT CARD ─── -->
                        <Border Margin="0,16,0,0"
                                Background="{StaticResource BrBgCard}"
                                BorderBrush="{StaticResource BrBorder}"
                                BorderThickness="1" CornerRadius="10" Padding="20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Text="✎" FontSize="16"
                                               Foreground="{StaticResource BrBlue}"
                                               Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock FontSize="15" FontWeight="Bold"
                                               Foreground="{StaticResource BrTextPrimary}"
                                               VerticalAlignment="Center">
                                        <Run Text="{Binding SelectedCurrency.Code, Mode=OneWay}" />
                                        <Run Text=" — Редагування / Новий запис" />
                                    </TextBlock>
                                </StackPanel>

                                <Separator Style="{StaticResource HRule}" />

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Style="{StaticResource LabelCaption}" Text="ПРАПОР" />
                                        <TextBox Text="{Binding EditFlag, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="20" TextAlignment="Center" Padding="4,8" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <TextBlock Style="{StaticResource LabelCaption}" Text="КОД" />
                                        <TextBox Text="{Binding EditCode, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="Cascadia Code, Consolas"
                                                 FontWeight="Bold" FontSize="14" Padding="8,10" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource LabelCaption}" Text="НАЗВА ВАЛЮТИ" />
                                        <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="10,10" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Style="{StaticResource LabelCaption}" Text="КУРС (ГРН)" />
                                        <TextBox Text="{Binding EditRate, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="Cascadia Code, Consolas"
                                                 FontSize="15" FontWeight="SemiBold" Padding="10,10" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource LabelCaption}" Text="ОДИНИЦЬ" />
                                        <TextBox Text="{Binding EditUnits, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="Cascadia Code, Consolas"
                                                 FontSize="15" TextAlignment="Center" Padding="6,10" />
                                    </StackPanel>
                                </Grid>

                                <Separator Style="{StaticResource HRule}" Margin="0,14,0,0" />

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               FontSize="11" Foreground="{StaticResource BrTextMuted}"
                                               VerticalAlignment="Center">
                                        <Run Text="Курс за " />
                                        <Run Text="{Binding EditUnits, Mode=OneWay}"
                                             FontFamily="Cascadia Code, Consolas" />
                                        <Run Text=" " />
                                        <Run Text="{Binding EditCode, Mode=OneWay}" />
                                        <Run Text=" → " />
                                        <Run Text="{Binding EditRate, Mode=OneWay}"
                                             FontFamily="Cascadia Code, Consolas"
                                             Foreground="{StaticResource BrAccent}" />
                                        <Run Text=" грн" />
                                    </TextBlock>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource BtnGhost}"
                                            Content="✕  Скасувати"
                                            Margin="0,0,8,0" FontSize="12" Padding="12,8"
                                            Command="{Binding CancelEditCommand}"
                                            Visibility="{Binding IsEditing,
                                                Converter={StaticResource BoolToVis}}" />
                                    <Button Grid.Column="2"
                                            Style="{StaticResource BtnBlue}"
                                            Content="💾  Зберегти"
                                            FontSize="12" Padding="14,8"
                                            Command="{Binding SaveCurrencyCommand}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Rectangle Height="16" />
                    </StackPanel>
                </ScrollViewer>

                <!-- ─── JOURNAL HEADER ─── -->
                <Border Grid.Row="1"
                        Padding="24,10,24,8"
                        Background="{StaticResource BrBgCard}"
                        BorderBrush="{StaticResource BrBorder}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="📋  ЖУРНАЛ КОНВЕРТАЦІЙ"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource BrTextSecond}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   FontSize="11" Foreground="{StaticResource BrTextMuted}"
                                   VerticalAlignment="Center">
                            <Run Text="{Binding History.Count, Mode=OneWay}" />
                            <Run Text=" записів" />
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- ─── JOURNAL DATAGRID ─── -->
                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding History}"
                          Background="{StaticResource BrBgDeep}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ЧАС"
                                            Binding="{Binding DisplayTime}"
                                            Width="150" />
                        <DataGridTextColumn Header="ВАЛЮТА"
                                            Binding="{Binding CurrencyCode}"
                                            Width="70" />
                        <DataGridTextColumn Header="СУМА (вал)"
                                            Binding="{Binding ForeignAmount, StringFormat={}{0:F2}}"
                                            Width="110" />
                        <DataGridTextColumn Header="СУМА (грн)"
                                            Binding="{Binding UahAmount, StringFormat={}{0:F2}}"
                                            Width="110" />
                        <DataGridTextColumn Header="КУРС"
                                            Binding="{Binding RateUsed, StringFormat={}{0:F4}}"
                                            Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- ─── CLEAR JOURNAL BUTTON ─── -->
                <Border Grid.Row="3"
                        Padding="24,8"
                        Background="{StaticResource BrBgCard}"
                        BorderBrush="{StaticResource BrBorder}"
                        BorderThickness="0,1,0,0">
                    <Button Content="🗑  Очистити журнал"
                            Style="{StaticResource BtnDanger}"
                            Command="{Binding ClearHistoryCommand}"
                            HorizontalAlignment="Left"
                            FontSize="12" Padding="12,7" />
                </Border>
            </Grid>
        </Grid>

        <!-- ════════ STATUS BAR ════════ -->
        <Border Grid.Row="2"
                Background="{StaticResource BrBgCard}"
                BorderBrush="{StaticResource BrBorder}"
                BorderThickness="0,1,0,0"
                Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="{StaticResource BrTextSecond}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           FontSize="11"
                           Foreground="{StaticResource BrTextMuted}"
                           VerticalAlignment="Center">
                    WPF · .NET 8 · MVVM · SQLite
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>