<Window x:Class="Lab5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab5"
        mc:Ignorable="d"
        Title="Довідник товарів - Варіант 8" Height="550" Width="850">
    <Grid>
        <TabControl>

            <!-- Завдання 2: Базові таблиці -->
            <TabItem Header="Товари">
                <DataGrid x:Name="dgProducts" AutoGenerateColumns="True" IsReadOnly="True" Margin="5"/>
            </TabItem>

            <TabItem Header="Одиниці виміру">
                <DataGrid x:Name="dgUnits" AutoGenerateColumns="True" IsReadOnly="True" Margin="5"/>
            </TabItem>

            <!-- Завдання 3: Запит 1 (JOIN) -->
            <TabItem Header="Запит 1 (JOIN)">
                <DockPanel>
                    <Button Content="Виконати JOIN запит (Товари + Одиниці)" 
                            DockPanel.Dock="Top" Height="35" Margin="10" 
                            Click="BtnJoin_Click"/>
                    <DataGrid x:Name="dgQuery1" AutoGenerateColumns="True" IsReadOnly="True" Margin="10"/>
                </DockPanel>
            </TabItem>

            <!-- Завдання 3: Запит 2 (Фільтрація) -->
            <TabItem Header="Запит 2 (Фільтр)">
                <StackPanel Margin="10">
                    <Label Content="Показати товари дорожчі за (грн):" FontSize="14"/>
                    <TextBox x:Name="txtMinPrice" Width="150" HorizontalAlignment="Left" Margin="5,0,0,10" Text="100"/>
                    <Button Content="Фільтрувати" Width="150" HorizontalAlignment="Left" Margin="5,0,0,10" 
                            Height="30" Click="BtnFilter_Click"/>
                    <DataGrid x:Name="dgQuery2" Height="300" AutoGenerateColumns="True" IsReadOnly="True"/>
                </StackPanel>
            </TabItem>

            <!-- Завдання 3: Запит 3 (Агрегація/Статистика) -->
            <TabItem Header="Запит 3 (Статистика)">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Button Content="Розрахувати загальну вартість складу" 
                            Width="300" Height="50" FontSize="16"
                            Click="BtnStats_Click"/>
                    <TextBlock x:Name="txtStats" FontSize="22" FontWeight="Bold" 
                               Margin="20" TextAlignment="Center" Foreground="DarkBlue"/>
                </StackPanel>
            </TabItem>

        </TabControl>
    </Grid>
</Window>